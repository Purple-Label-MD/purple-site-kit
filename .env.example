# ─────────────────────────────────────────────────────────────────────────────
# purple-site-kit — LAUNCH template environment
#
# GOVERNANCE-LITE ③: NEVER commit real credentials. Copy this file to `.env.local`
# and fill it in there (`.env.local` is git-ignored). Credentials come ONLY from
# the environment — nothing is hardcoded in source (see lib/config.ts).
# ─────────────────────────────────────────────────────────────────────────────

# ── Purple API base URL (config-driven; ZERO hardcoded endpoints) ──────────────
# The projected public gateway base, including the /v1 prefix. When UNSET, the
# template runs against its built-in synthetic mock (see app/api/mock) so a fresh
# clone is runnable and demonstrable with no credentials at all. Set this to the
# real gateway once your dev client is provisioned.
#   e.g. https://api.<your-purple-gateway>/v1
NEXT_PUBLIC_PURPLE_API_BASE=

# Force mock mode explicitly (default: mock is used whenever the base URL is unset).
# Set to "false" together with a real base URL + key to go live.
NEXT_PUBLIC_PURPLE_MOCK=

# ── Tenancy (from your provisioned dev client) ─────────────────────────────────
# Brand id (brd_...) selects which brand config in /brands is active + is sent as
# the X-Brand-Id header on tenant-scoped calls.
NEXT_PUBLIC_PURPLE_BRAND_ID=brd_demo_aurora

# A stable offering ref preselected on entry links (never a free-text product name).
NEXT_PUBLIC_PURPLE_OFFERING_REF=offering_launch_starter

# ── Server-only secrets (NEVER prefixed NEXT_PUBLIC_, never sent to the browser) ─
# Per-client M2M API key, presented as `Authorization: Bearer <key>`. Server-side
# only. Leave blank to stay in credential-free mock mode.
PURPLE_API_KEY=

# HMAC signing secret (psig_...) shown ONCE when you register a webhook endpoint.
# Used by the example receiver to verify X-Purple-Signature. Server-side only.
PURPLE_WEBHOOK_SECRET=
